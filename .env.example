# SMTP credentials for the discount-lead form (/api/discount-lead).
# Copy this file to .env.local and fill in real values. Do NOT commit .env.local.
#
# Any SMTP provider works (Gmail App Password, SendGrid, Mailgun, Postmark, AWS SES, etc.).
# Common Gmail values:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=info@austrowebnlogo.com
#   SMTP_PASS=<app password>

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@austrowebnlogo.com
SMTP_PASS=Austro@123^&*123

# Optional. Defaults to "Austro Web & Logo Leads <SMTP_USER>".
SMTP_FROM=

# Inbox that receives the discount-lead submissions.
LEAD_RECEIVER_EMAIL=info@austrowebnlogo.com
