# SMTP credentials for the discount-lead form (/api/discount-lead).
#
# This file is only a template — copy it to `.env.local` for local development
# (the .gitignore excludes .env.local from version control), and configure the
# SAME variables in your hosting provider's environment panel for production
# (Vercel project settings → Environment Variables, Hostinger → Advanced →
# Environment Variables, etc.). Without these set on the live server, the
# discount popup form will return "Email service is not configured" and no
# email will be delivered.
#
# Common provider settings:
#   Hostinger:  host=smtp.hostinger.com, port=465, secure=true
#   Gmail:      host=smtp.gmail.com,     port=465, secure=true   (use an App Password)
#   SendGrid:   host=smtp.sendgrid.net,  port=587, secure=false
#   Mailgun:    host=smtp.mailgun.org,   port=587, secure=false

SMTP_SECURE=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@austrowebnlogo.com
SMTP_PASS=Austro@123UJDFLKJ123

# Optional. Defaults to `Austro Web & Logo Leads <SMTP_USER>`.
SMTP_FROM=

# Inbox that receives every discount-lead submission.
LEAD_RECEIVER_EMAIL=info@austrowebnlogo.com
